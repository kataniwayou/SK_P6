<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore configuration (SK_P — offline-machine build support).

  All packages restore from the repo-local `nugets/` folder feed ONLY. nuget.org is removed
  (`<clear/>`) so a build on a fully-disconnected machine never reaches the network, and a
  missing package fails loudly at restore instead of silently hitting the internet.

  `nugets/` holds the complete transitive closure (134 .nupkg) pinned by the per-project
  packages.lock.json files — identical on the online build machine and the offline target.

  The machine global-package fallback folders are cleared too, so restore is proven against
  the offline feed alone (not a warm ~/.nuget/packages cache).

  NOTE: this same config is COPYied into each Docker build context, so the in-container
  `dotnet restore` (Linux) resolves from the copied `nugets/` folder as well.
  For offline machines, also set env NUGET_CERT_REVOCATION_MODE=offline (see OFFLINE-SETUP.md)
  to skip online certificate-revocation checks during restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline" value="nugets" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
